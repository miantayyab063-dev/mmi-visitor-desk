# Hostinger Apache/LiteSpeed: redirect before presenting any login form.
<IfModule mod_rewrite.c>
 RewriteEngine On
 RewriteCond %{HTTPS} !=on
 RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=302,L]
</IfModule>
Options -Indexes
DirectoryIndex index.html
<IfModule mod_headers.c>
 Header always set X-Content-Type-Options "nosniff"
 Header always set X-Frame-Options "DENY"
 Header always set Referrer-Policy "no-referrer"
 Header always set Content-Security-Policy "default-src 'self'; style-src 'self' 'unsafe-inline'; script-src 'self'; frame-ancestors 'none'"
</IfModule>
<FilesMatch "(?i)(\.sql$|\.sqlite3|\.log$|\.bak$|\.ini$|\.env|config\.|schema\.)">
 Require all denied
</FilesMatch>
